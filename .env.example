# After-hours maintenance call routing. Full setup walkthrough:
# docs/oncall-routing.md

# The Twilio number tenants call. Every technician sees THIS number when the
# call is forwarded, which is what makes an iPhone/Android Emergency Bypass rule
# work. Leave blank and the number the tenant dialed is used instead.
TWILIO_MAIN_LINE=+12065550100

# From the Twilio Console dashboard. The auth token both proves incoming
# webhooks really came from Twilio and lets the app send the "who is calling"
# text. Without them the line still answers, but it rings the backup manager
# and sends no texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Who rings when the on-call tech misses the call, and who gets a text with a
# link to any voicemail (defaults to the backup manager).
ONCALL_BACKUP_PHONE=+12065550199
# ONCALL_VOICEMAIL_NOTIFY=+12065550199,+12065550134

# Where calls go during business hours. Leave blank to send every call to the
# on-call rotation, day or night.
ONCALL_OFFICE_PHONE=+12065550111

# The on-call rotation calendar. Share the calendar with the service account
# address (read access is enough), then paste its key here. Keep the private
# key on one line with \n escapes exactly as Google gives it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# When the rotation is in charge. Defaults: 5:00 pm to 8:00 am, all weekend,
# Seattle time. ONCALL_ALWAYS=true ignores the clock entirely.
# ONCALL_TIMEZONE=America/Los_Angeles
# ONCALL_EVENING_START_HOUR=17
# ONCALL_MORNING_END_HOUR=8
# ONCALL_WEEKEND_ALL_DAY=true
# ONCALL_ALWAYS=false

# How long each phone rings (seconds) and how many times the on-call tech is
# tried before the backup manager.
# ONCALL_DIAL_TIMEOUT=25
# ONCALL_TECH_ATTEMPTS=2

# Spoken in the voicemail greeting.
# ONCALL_COMPANY_NAME=Milestone Properties

# ─────────────────────────────────────────────────────────────────────────────
# Which unit is calling
# ─────────────────────────────────────────────────────────────────────────────
# The caller ID is matched against the tenant directory in Supabase and the
# unit goes in the technician's text: "Willow Lake #V-12, Nadia Kovacs".
# Needs SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below, plus
# docs/oncall-caller-lookup.sql run once in the Supabase SQL editor.
# On by default whenever Supabase is configured; set to false to stop asking.
# ONCALL_CALLER_LOOKUP=true

# ─────────────────────────────────────────────────────────────────────────────
# Recording calls — off unless you turn it on
# ─────────────────────────────────────────────────────────────────────────────
# Washington is an all-party consent state (RCW 9.73.030): everyone on the call
# has to be told it is being recorded. With this on, every caller hears "This
# call will be recorded for maintenance records" before anything is dialed, and
# your technicians must be told in writing when they join the rotation.
#
# Only the rotation's own calls are recorded. A call that reaches the office
# during business hours is left alone — whoever is at that desk did not join an
# on-call rotation. (ONCALL_ALWAYS=true removes the distinction, since then
# every call belongs to the rotation.)
#
# Recordings are listed at /calls, behind ONCALL_DASHBOARD_PASSWORD.
# ONCALL_RECORD_CALLS=false

# Required before GET /api/oncall/status will show full phone numbers.
ONCALL_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Scheduling dashboard (/schedule) — optional
# Leave ONCALL_DASHBOARD_PASSWORD unset and the dashboard is disabled entirely.
# An unset password never means "no password required" on a page that can
# rewrite the emergency rotation.
# ─────────────────────────────────────────────────────────────────────────────

# One shared password for whoever schedules the rotation. Changing it signs
# everyone out immediately.
ONCALL_DASHBOARD_PASSWORD=

# The technician roster (docs/oncall-techs.sql), the tenant directory lookup and
# the call log (docs/oncall-caller-lookup.sql). Run both in the Supabase SQL
# editor. Routing itself never depends on any of them: a shift carries its own
# phone number, so a call still reaches a human with Supabase down — the text
# just arrives without the unit on it.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: server-only, never
# prefixed with NEXT_PUBLIC_.
SUPABASE_URL=https://augbrysfqwgekfhfokco.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The Google service account also needs "Make changes to events" on the calendar
# (not just "See all event details") before the dashboard can write shifts.

# Your deployment's public URL. Only needed if Twilio signature checks fail
# behind a custom domain or proxy.
# ONCALL_PUBLIC_BASE_URL=https://milestone-oncall.vercel.app
