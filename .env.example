# After-hours maintenance call routing. Full setup walkthrough:
# docs/oncall-routing.md

# The Twilio number tenants call. Every technician sees THIS number when the
# call is forwarded, which is what makes an iPhone/Android Emergency Bypass rule
# work. Leave blank and the number the tenant dialed is used instead.
TWILIO_MAIN_LINE=+12065550100

# From the Twilio Console dashboard. The auth token both proves incoming
# webhooks really came from Twilio and lets the app send the "who is calling"
# text. Without them the line still answers, but it rings the backup manager
# and sends no texts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Who rings when the on-call tech misses the call, and who gets a text with a
# link to any voicemail (defaults to the backup manager).
ONCALL_BACKUP_PHONE=+12065550199
# ONCALL_VOICEMAIL_NOTIFY=+12065550199,+12065550134

# Where calls go during business hours. Leave blank to send every call to the
# on-call rotation, day or night.
ONCALL_OFFICE_PHONE=+12065550111

# The on-call rotation calendar. Share the calendar with the service account
# address (read access is enough), then paste its key here. Keep the private
# key on one line with \n escapes exactly as Google gives it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# When the rotation is in charge. Defaults: 5:00 pm to 8:00 am, all weekend,
# Seattle time. ONCALL_ALWAYS=true ignores the clock entirely.
# ONCALL_TIMEZONE=America/Los_Angeles
# ONCALL_EVENING_START_HOUR=17
# ONCALL_MORNING_END_HOUR=8
# ONCALL_WEEKEND_ALL_DAY=true
# ONCALL_ALWAYS=false

# How long each phone rings (seconds) and how many times the on-call tech is
# tried before the backup manager.
# ONCALL_DIAL_TIMEOUT=25
# ONCALL_TECH_ATTEMPTS=2

# Spoken in the voicemail greeting.
# ONCALL_COMPANY_NAME=Milestone Properties

# Required before GET /api/oncall/status will show full phone numbers.
ONCALL_API_KEY=

# Your deployment's public URL. Only needed if Twilio signature checks fail
# behind a custom domain or proxy.
# ONCALL_PUBLIC_BASE_URL=https://milestone-oncall.vercel.app
